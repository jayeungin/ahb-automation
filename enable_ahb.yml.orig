---
- name: Enable Azure Hybrid Benefit for all running RHEL VMs in Tenant
  hosts: localhost
  connection: local
  gather_facts: false

  vars:
    # Target license type. Options: RHEL_BYOS, RHEL_BASE, RHEL_EUS, RHEL_SAPHA
    rhel_license_type: "RHEL_BYOS"

  tasks:
    - name: Query Azure Resource Graph for all running RHEL VMs lacking AHB
      ansible.builtin.command:
        cmd: >
          az graph query -q "
          Resources
          | where type =~ 'microsoft.compute/virtualmachines'
          | where tostring(properties.extended.instanceView.powerState.code) =~ 'PowerState/running'
          | where tostring(properties.storageProfile.imageReference.publisher) =~ 'RedHat'
              or (tostring(properties.storageProfile.osDisk.osType) =~ 'Linux' and tostring(properties.extended.instanceView.osName) has 'Red Hat')
          | where isnull(properties.licenseType) or tostring(properties.licenseType) !in~ ('RHEL_BYOS', 'RHEL_BASE', 'RHEL_EUS', 'RHEL_SAPAPPS', 'RHEL_SAPHA')
          | project name, resourceGroup, subscriptionId, id, location, currentLicense = properties.licenseType
          " -o json
      register: rhel_vm_query
      changed_when: false

    - name: Parse discovered VMs
      ansible.builtin.set_fact:
        target_vms: "{{ (rhel_vm_query.stdout | from_json).data }}"

    - name: Display discovered target VMs
      ansible.builtin.debug:
        msg: >-
          Discovered {{ target_vms | length }} running RHEL VM(s) needing AHB:
          {{ target_vms | map(attribute='name') | list }}

    - name: Apply AHB extension and update license type
      when: target_vms | length > 0
      block:
        - name: Install AHB for RHEL VM extension
          azure.azcollection.azure_rm_virtualmachineextension:
            subscription_id: "{{ item.subscriptionId }}"
            resource_group: "{{ item.resourceGroup }}"
            virtual_machine_name: "{{ item.name }}"
            name: "AHBForRHEL"
            publisher: "Microsoft.Azure.AzureHybridBenefit"
            virtual_machine_extension_type: "AHBForRHEL"
            type_handler_version: "1.0"
            auto_upgrade_minor_version: true
            state: present
          loop: "{{ target_vms }}"
          loop_control:
            label: "{{ item.name }} ({{ item.resourceGroup }})"

        - name: Update VM license type to RHEL_BYOS
          azure.azcollection.azure_rm_resource:
            subscription_id: "{{ item.subscriptionId }}"
            resource_group: "{{ item.resourceGroup }}"
            provider: "Microsoft.Compute"
            resource_type: "virtualMachines"
            resource_name: "{{ item.name }}"
            api_version: "2023-09-01"
            method: PATCH
            body:
              properties:
                licenseType: "{{ rhel_license_type }}"
          loop: "{{ target_vms }}"
          loop_control:
            label: "{{ item.name }} (Sub: {{ item.subscriptionId }})"
          register: patch_results

    - name: Completion status
      ansible.builtin.debug:
        msg: "Azure Hybrid Benefit successfully applied to {{ target_vms | length }} VM(s)."